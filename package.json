    "emails": "node src/collect-emails.js",
    "emails:ui": "node src/email-ui.js",
    "test:email": "node test/email-harvest.test.js",
    "telapo": "node src/telapo-ui.js",
    "telapo:dashboard": "node src/telapo-analyze.js",
    "telapo:analyze": "node src/analyze-talk-rejection.js",
    "test:telapo": "node test/telapo.test.js",
    "test:boshudan": "node test/boshudan-needs.test.js",
