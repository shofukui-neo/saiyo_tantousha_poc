    "mochica:max": "node src/build-named-mochica-max.js --out data/leads-named-mochica-max.csv",
    "names:plus": "node src/harvest-named-plus.js --in data/leads-recruiter-acquired-1000.csv --out data/recruiter-fused.csv",
    "names:plus:live": "node src/harvest-named-plus.js --in data/recruiter-wantedly.csv --out data/recruiter-fused-live.csv --live --concurrency 3",
    "names:gbiz": "node src/harvest-named-plus.js --in data/leads-mochica-target.csv --out data/recruiter-gbiz-rep.csv --gbiz-first --concurrency 2",
    "names:gbiz:live": "node src/harvest-named-plus.js --in data/leads-mochica-target.csv --out data/recruiter-gbiz-plus.csv --gbiz-first --live --no-search --concurrency 2",
